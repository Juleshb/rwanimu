{
  "compilerOptions": {
    "module": "CommonJS", "target": "ES2022", "strict": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "rootDir": "src", "outDir": "dist", "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"], "exclude": ["dist", "node_modules"]
}
